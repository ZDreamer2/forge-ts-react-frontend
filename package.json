{
	"name": "@zdreamer/forge-ts-react-frontend",
	"version": "0.4.0",
	"description": "Opinionated presets, structural enforcement and test lifecycle support for Forge React frontends",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ZDreamer2/forge-ts-react-frontend.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"presets/",
		"dist/",
		"src/"
	],
	"exports": {
		"./biome": "./presets/biome-preset.json",
		"./tsconfig": "./presets/tsconfig.json",
		"./structure": {
			"types": "./dist/structure.d.ts",
			"default": "./dist/structure.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"default": "./dist/testing/index.js"
		},
		"./testing/http": {
			"types": "./dist/testing/http.d.ts",
			"default": "./dist/testing/http.js"
		}
	},
	"engines": {
		"node": ">=24.18.1 <25"
	},
	"packageManager": "pnpm@11.15.1",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "biome check --config-path=presets/biome-preset.json package.json presets src tests vitest.config.ts tsconfig.build.json tsconfig.tests.json",
		"test": "node --test tests/*.test.mjs && vitest run",
		"test:structure": "node --test tests/structure.test.mjs",
		"check": "node --run build && node --run typecheck && node --run lint && node --run test",
		"typecheck": "tsc -p tsconfig.tests.json"
	},
	"peerDependencies": {
		"@biomejs/biome": "2.5.4",
		"typescript": "7.0.2",
		"@tanstack/query-core": "^5.102.8",
		"vitest": "^4.1.11"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"@tanstack/query-core": "5.102.8",
		"vitest": "4.1.11",
		"jsdom": "30.0.1",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@testing-library/react": "16.3.3",
		"@tanstack/react-query": "5.102.8"
	},
	"peerDependenciesMeta": {
		"@tanstack/query-core": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"dependencies": {
		"msw": "2.15.0"
	}
}
