{
	"name": "@zdreamer/forge-ts-react-frontend",
	"version": "0.2.0",
	"description": "Opinionated Biome and browser TypeScript presets for Forge React frontends",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ZDreamer2/forge-ts-react-frontend.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"presets/"
	],
	"exports": {
		"./biome": "./presets/biome-preset.json",
		"./tsconfig": "./presets/tsconfig.json"
	},
	"engines": {
		"node": ">=24.18.1 <25"
	},
	"packageManager": "pnpm@11.15.1",
	"scripts": {
		"lint": "biome check --config-path=presets/biome-preset.json package.json presets tests",
		"test": "node --test",
		"check": "biome check --config-path=presets/biome-preset.json package.json presets tests && node --test"
	},
	"peerDependencies": {
		"@biomejs/biome": "2.5.4",
		"typescript": "7.0.2"
	}
}
